{# 
   ********************************************************************************
    NOTIFICATION FIXE EN BAS À GAUCHE AVEC AUTO-DISPARITION APRÈS 5 SECONDES
   ********************************************************************************
#}

{% for type, messages in app.flashes %}
    {% for message in messages %}
        
        {% set alert_color = type in ['success', 'warning', 'danger', 'info'] ? type : 'primary' %}

        <div class="alert alert-{{ alert_color }} alert-dismissible fade show 
                    position-fixed bottom-0 start-0 m-3 w-25 alert-autoclose" 
            role="alert"
            style="z-index: 1050;">

            {{ message|raw|trans }} 

            <button type="button" 
                    class="btn-close" 
                    data-bs-dismiss="alert" 
                    aria-label="Close"></button>
        </div>

    {% endfor %}
{% endfor %}

{# 
   ********************************************************************************
    SCRIPT JAVASCRIPT POUR L'AUTO-FERMETURE
   ********************************************************************************
#}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Cibler tous les éléments d'alerte avec la classe 'alert-autoclose'
        const autocloseAlerts = document.querySelectorAll('.alert-autoclose');

        autocloseAlerts.forEach(alertElement => {
            // Définir le délai de 5000 millisecondes (5 secondes)
            const delay = 5000; 
            
            // Lancer le timer
            setTimeout(function() {
                // Trouver le bouton de fermeture
                const closeButton = alertElement.querySelector('.btn-close');
                
                // Si le bouton existe, simuler un clic pour déclencher la fermeture Bootstrap
                if (closeButton) {
                    closeButton.click();
                } else {
                    // Si pas de bouton, masquer directement l'alerte
                    alertElement.style.display = 'none'; 
                }
            }, delay);
        });
    });
</script>