{% for type, messages in app.flashes %}
    {% for message in messages %}
        
        {% set alert_color = type in ['success', 'warning', 'danger', 'info'] ? type : 'primary' %}

        <div class="alert alert-{{ alert_color }} alert-dismissible fade show 
                    position-fixed bottom-0 start-0 m-3 w-25 alert-autoclose" 
            role="alert"
            style="z-index: 1050;">

            {{ message|raw|trans }} 

            <button type="button" 
                    class="btn-close" 
                    data-bs-dismiss="alert" 
                    aria-label="Close"></button>
        </div>

    {% endfor %}
{% endfor %}