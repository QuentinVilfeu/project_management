{% if app.user %}
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background-color: #1a1a2e;">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <i class="fas fa-rocket me-2"></i> {% trans %}Homepage{% endtrans %}
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    {% if is_granted('ROLE_MAINTAINER') %}
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="{{ path('app_project') }}" data-turbo="true">{% trans %}Projects{% endtrans %}</a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user') }}" data-turbo="true">{% trans %}Users{% endtrans %}</a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_state') }}" data-turbo="true">{% trans %}States{% endtrans %}</a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_priority') }}" data-turbo="true">{% trans %}Priorities{% endtrans %}</a>
                        </li>
                    {% endif %}
                </ul>

                
                    <div class="d-flex">
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-light custom-btn-glow">{% trans %}Logout{% endtrans %}</a>
                    </div>
            </div>
        </div>
    </nav>
{% endif %}