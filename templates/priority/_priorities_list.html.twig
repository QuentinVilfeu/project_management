<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{% trans %}Priority list{% endtrans %}</h2>
        <!-- Button triggers modal -->
        <button
            {{ stimulus_target('modal', 'openModalButton') }}
            type="button"
            class="btn custom-btn"
            data-bs-toggle="modal"
            data-bs-target="#newPriorityModal"
            data-route="app_priority_new">
            {% trans %}Add priority{% endtrans %}
        </button>
    </div>

    <table id="priorityList"
        class="table table-bordered table-hover" 
        data-toggle="table"
        data-pagination="true"
        data-search="true"
        data-show-search-clear-button="true"
        data-filter-control="true"
        data-locale="{{ app.request.locale|default('fr')|replace({'_':'-'}) }}">
        <thead>
            <tr>
                <th data-sortable="true" data-field="id">Id</th>
                <th data-sortable="true" data-filter-control="select" data-field="title">{% trans %}Title{% endtrans %}</th>
                <th data-field="color">{% trans %}Color{% endtrans %}</th>
                <th data-sortable="true" data-field="weight">{% trans %}Weight{% endtrans %}</th>
                <th>{% trans %}Actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
            {% for priority in priorities %}
                <tr>
                    <td>{{ priority.id }}</td>
                    <td>{{ priority.title }}</td>
                    <td><span class="badge" style="background-color: {{ priority.color }}">{{ priority.color }}</span></td>
                    <td>{{ priority.weight }}</td>
                    <td>
                        <a id="edit_priority_{{ priority.id }}"
                            class="btn btn-sm btn-outline-primary custom-btn"
                            title="{{ 'Edit priority'|trans }}"
                            {{ stimulus_target('modal', 'openModalButton') }}
                            {{ stimulus_action('modal', 'clickActionTable') }}
                            data-bs-toggle="modal"
                            data-bs-target="#editPriorityModal"
                            data-route="app_priority_edit"
                            data-parameters="{{ {'id': priority.id}|json_encode|e('html_attr') }}">
                                <!-- pencil icon -->
                                <i class="bi bi-pencil"></i>
                        </a>
                        <a id="delete_priority_{{ priority.id }}"
                            class="btn btn-sm btn-outline-danger"
                            title="{{ 'Delete Priority'|trans }}"
                            {{ stimulus_target('modal', 'openModalButton') }}
                            {{ stimulus_action('modal', 'clickActionTable') }}
                            data-bs-toggle="modal"
                            data-bs-target="#deletePriorityModal"
                            data-route="app_priority_delete"
                            data-parameters="{{ {'id': priority.id}|json_encode|e('html_attr') }}">
                                <!-- trash icon -->
                                <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
