<div class="container">
    <div class="sub-container d-flex justify-content-between align-items-center mb-3">
        <h2>{% trans %}Task list{% endtrans %}</h2>
        <!-- Button triggers modal -->
        <button
            {{ stimulus_action('modal', 'clickActionTable') }}
            type="button"
            class="btn custom-btn"
            data-bs-toggle="modal"
            data-bs-target="#newTaskModal"
            data-route="app_task_new">
            {% trans %}Add task{% endtrans %}
        </button>
    </div>
    <div class="sub-container">
        <table id="taskList"
            class="table table-bordered table-hover" 
            data-toggle="table"
            data-pagination="true"
            data-search="true"
            data-show-search-clear-button="true"
            data-filter-control="true"
            data-locale="{{ app.request.locale|default('fr')|replace({'_':'-'}) }}">
            <thead>
                <tr>
                    <th data-sortable="true" data-field="id">Id</th>
                    <th data-sortable="true" data-filter-control="select" data-field="project">{% trans %}Project{% endtrans %}</th>
                    <th data-filter-control="input" data-field="title">{% trans %}Title{% endtrans %}</th>
                    <th data-sortable="true" data-filter-control="select" data-field="assignee">{% trans %}Assignee{% endtrans %}</th>
                    <th data-sortable="true" data-filter-control="select" data-field="priority">{% trans %}Priority{% endtrans %}</th>
                    <th data-sortable="true" data-filter-control="select" data-field="state">{% trans %}State{% endtrans %}</th>
                    <th data-sortable="true" data-field="initialDateEnd">{% trans %}Initial end date{% endtrans %}</th>
                    <th data-sortable="true" data-field="closingDate">{% trans %}Closing date{% endtrans %}</th>
                    <th>{% trans %}Actions{% endtrans %}</th>
                </tr>
            </thead>
            <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>{{ task.id }}</td>
                        <td>{{ task.project }}</td>
                        <td>{{ task.title }}</td>
                        <td class="text-center">{{ task.assignee }}</td>
                        <td class="text-center">{% if task.priority %}<span class="badge" style="background-color: {{ task.priority.color }}">{{ task.priority }}</span>{% endif %}</td>
                        <td class="text-center"><span class="badge" style="background-color: {{ task.state.color }}">{{ task.state }}</span></td>
                        <td class="bg-{{ task.getDeadlineStatus }} text-center">{{ task.initialEndDate ? task.initialEndDate|date('d-m-Y') : '' }}</td>
                        <td class="text-center">{{ task.closingDate ? task.closingDate|date('d-m-Y') : '' }}</td>
                        <td class="actions-column">
                            <a id="page_task_{{ task.id }}"
                                class="btn btn-sm btn-outline-success"
                                title="{{ 'Page task'|trans }}"
                                data-turbo="false"
                                href="{{ path('app_task_page', {id: task.id}) }}">
                                    <i class="bi bi-eye"></i>
                            </a>
                            <a id="edit_task_{{ task.id }}"
                                class="btn btn-sm btn-outline-primary custom-btn"
                                title="{{ 'Edit task'|trans }}"
                                {{ stimulus_action('modal', 'clickActionTable') }}
                                data-bs-toggle="modal"
                                data-bs-target="#editTaskModal"
                                data-route="app_task_edit"
                                data-parameters="{{ {'id': task.id}|json_encode|e('html_attr') }}">
                                    <i class="bi bi-pencil"></i>
                            </a>
                            {# <a id="delete_task_{{ task.id }}"
                                class="btn btn-sm btn-outline-danger"
                                title="{{ 'Delete Task'|trans }}"
                                {{ stimulus_action('modal', 'clickActionTable') }}
                                data-bs-toggle="modal"
                                data-bs-target="#deleteTaskModal"
                                data-route="app_task_delete"
                                data-parameters="{{ {'id': task.id}|json_encode|e('html_attr') }}">
                                    <i class="bi bi-trash"></i>
                            </a> #}
                            <a id="close_task_{{ task.id }}"
                                class="btn btn-sm btn-outline-danger"
                                title="{{ 'Close task'|trans }}"
                                {{ stimulus_action('modal', 'clickActionTable') }}
                                data-bs-toggle="modal"
                                data-bs-target="#closeTaskModal"
                                data-route="app_task_close"
                                data-parameters="{{ {'id': task.id}|json_encode|e('html_attr') }}">
                                    <i class="bi bi-calendar-x"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
