{% if action is defined and action == "actionEditPriority" %}
    <button class="btn dropdown-toggle text-white" 
            type="button" 
            id="changePriorityButton" 
            data-bs-toggle="dropdown" 
            aria-expanded="false"
            style="background-color:{{ task.priority.color }}">
        {{ task.priority.title }}
    </button>

    <ul class="dropdown-menu" 
        aria-labelledby="changePriorityButton">
            {% for priority in priorities %}
                <li><a
                    {{ stimulus_action('task_action', 'updatePriority') }}
                    class="dropdown-item" style="color:{{ priority.color }}" data-action-task-id="{{ task.id }}" data-action-priority-id="{{ priority.id }}">{{ priority.title }}</a></li>
            {% endfor %}
    </ul>
{% endif %}

{% if action is defined and action == "actionEditState" %}
    <button class="btn dropdown-toggle text-white" 
            type="button" 
            id="changeStateButton" 
            data-bs-toggle="dropdown" 
            aria-expanded="false"
            style="background-color:{{ task.state.color }}">
        {{ task.state.title }}
    </button>

    <ul class="dropdown-menu" 
        aria-labelledby="changeStateButton">
            {% for state in states %}
                <li><a {{ stimulus_action('task_action', 'updateState') }}
                    class="dropdown-item" href="#" style="color:{{ state.color }}" data-action-task-id="{{ task.id }}" data-action-state-id="{{ state.id }}">{{ state.title }}</a></li>
            {% endfor %}
    </ul>
{% endif %}

{% if action is defined and action == "actionEditAssignee" %}
    <button class="btn btn-secondary dropdown-toggle" 
            type="button" 
            id="changeAssigneeButton" 
            data-bs-toggle="dropdown" 
            aria-expanded="false">
        {{ task.assignee }}
    </button>

    <ul class="dropdown-menu" 
        aria-labelledby="changeAssigneeButton">
            {% for user in users %}
                <li><a {{ stimulus_action('task_action', 'updateAssignee') }}
                    data-action-task-id="{{ task.id }}" data-action-assignee-id="{{ user.id }}"
                    class="dropdown-item" href="#">{{ user ~ ' (' ~ user.email ~ ')' }}</a></li>
            {% endfor %}
    </ul>
{% endif %}