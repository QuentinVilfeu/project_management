<form method="post" action="{{ path('app_state_delete', {'id': state.id}) }}">
    <div class="modal-body">
        <p>{{ 'Confirm deletion'|trans({'%name%': state.title}) }}</p>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-danger">{{ 'Delete'|trans }}</button>
    </div>
</form>