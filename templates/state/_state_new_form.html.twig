{% form_theme form 'form/custom_errors.html.twig' %}

{{ form_start(form, {'action': path('app_state_new')}) }}
    {{ form_widget(form._token) }}
    <div class="mb-3">
        {{ form_label(form.title) }}
        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.title) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.color) }}
        {{ form_widget(form.color, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.color) }}
    </div>
    <div class="mb-3">
        {{ form_label(form.weight) }}
        {{ form_widget(form.weight, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.weight) }}
    </div>
    {{ form_row(form.isClosingState) }}
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">{% trans %}Create State{% endtrans %}</button>
    </div>
{{ form_end(form) }}