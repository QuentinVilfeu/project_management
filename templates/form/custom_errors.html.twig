{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="list-unstyled mb-0 text-danger">
            {# Itération sur toutes les erreurs du champ ou du formulaire #}
            {% for error in errors %}
                <li>{{ error.message|trans }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock form_errors %}

{# Surcharge du bloc pour les checkboxes multiples (expanded) #}
{% block choice_widget_expanded %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' form-check-inline')|trim}) %}
    
    {% for child in form %}
        <div class="role-button-item">
            {{ form_widget(child, {'attr': attr}) }}
            {{ form_label(child) }}
        </div>
    {% endfor %}
{% endblock %}

{# Vous pouvez aussi vouloir surcharger le bloc de rendu d'une checkbox individuelle #}
{% block checkbox_widget %}
    {% set label_attr = label_attr|merge({'class': 'btn btn-outline-success'}) %}

    <input type="checkbox" id="{{ id }}" name="{{ full_name }}" value="{{ value }}" 
        {% if checked %}checked="checked"{% endif %}
        {{ block('widget_attributes') }} 
        class="d-none" />
    <label for="{{ id }}" class="{{ label_attr.class|default('') }}">{{ label|trans }}</label>
{% endblock %}

{% block form_label %}
    {% if label is same as (false) %}
        {# Ne rien afficher si le label est explicitement masqué #}
        {% set label = false %}
    {% else %}
        {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' form-label')|trim}) %}
        
        {# Affiche le label normalement #}
        {{- block('form_label_content') -}}

        {# Ajoute l'astérisque rouge si le champ est requis #}
        {% if required %}
            <span class="required-asterisk" style="color: red; font-weight: bold;">*</span>
        {% endif %}
    {% endif %}
{% endblock %}