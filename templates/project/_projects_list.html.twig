<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{% trans %}Project list{% endtrans %}</h2>
        <!-- Button triggers modal -->
        <button
            {{ stimulus_target('modal', 'openModalButton') }}
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#newProjectModal"
            data-route="app_project_new">
            {% trans %}Add Project{% endtrans %}
        </button>
    </div>

    <table id="projectList"
        class="table"
        data-toggle="table"
        data-pagination="true"
        data-search="true"
        data-show-search-clear-button="true"
        data-filter-control="true">
        <thead>
            <tr>
                <th data-sortable="true" data-field="id">Id</th>
                <th data-sortable="true" data-filter-control="select" data-field="firstname">{% trans %}Title{% endtrans %}</th>
                <th>{% trans %}Actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
            {% for project in projects %}
                <tr>
                    <td>{{ project.id }}</td>
                    <td>{{ project.title }}</td>
                    <td>
                        <a id="edit_project_{{ project.id }}"
                        class="btn btn-sm btn-outline-primary"
                        title="{{ 'Edit Project'|trans }}"
                        {{ stimulus_target('modal', 'openModalButton') }}
                        {{ stimulus_action('modal', 'clickActionTable') }}
                        data-bs-toggle="modal"
                        data-bs-target="#editProjectModal"
                        data-route="app_project_edit"
                        data-parameters="{{ {'id': project.id}|json_encode|e('html_attr') }}">
                            <!-- pencil icon -->
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a id="delete_project_{{ project.id }}"
                        class="btn btn-sm btn-outline-danger"
                        title="{{ 'Delete Project'|trans }}"
                        {{ stimulus_target('modal', 'openModalButton') }}
                        {{ stimulus_action('modal', 'clickActionTable') }}
                        data-bs-toggle="modal"
                        data-bs-target="#deleteProjectModal"
                        data-route="app_project_delete"
                        data-parameters="{{ {'id': project.id}|json_encode|e('html_attr') }}">
                            <!-- trash icon -->
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
