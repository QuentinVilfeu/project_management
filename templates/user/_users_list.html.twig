<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{% trans %}User list{% endtrans %}</h2>
        <!-- Button triggers modal -->
        <button
            {{ stimulus_target('modal', 'openModalButton') }}
            type="button"
            class="btn custom-btn"
            data-bs-toggle="modal"
            data-bs-target="#newUserModal"
            data-route="app_user_new">
            {% trans %}Add User{% endtrans %}
        </button>
    </div>

    <table id="userList"
        class="table table-bordered table-hover" 
        data-toggle="table"
        data-pagination="true"
        data-search="true"
        data-show-search-clear-button="true"
        data-filter-control="true"
        data-locale="{{ app.request.locale|default('fr')|replace({'_':'-'}) }}">
        <thead>
            <tr>
                <th data-sortable="true" data-field="id">Id</th>
                <th data-sortable="true" data-filter-control="input" data-field="firstname">{% trans %}Firstname{% endtrans %}</th>
                <th data-sortable="true" data-filter-control="input" data-field="lastname">{% trans %}Lastname{% endtrans %}</th>
                <th data-sortable="true" data-filter-control="input" data-field="email">{% trans %}Email{% endtrans %}</th>
                <th>{% trans %}Actions{% endtrans %}</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.firstname }}</td>
                    <td>{{ user.lastname }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        <a id="edit_user_{{ user.id }}"
                            class="btn btn-sm btn-outline-primary custom-btn"
                            title="{{ 'Edit user'|trans }}"
                            {{ stimulus_target('modal', 'openModalButton') }}
                            {{ stimulus_action('modal', 'clickActionTable') }}
                            data-bs-toggle="modal"
                            data-bs-target="#editUserModal"
                            data-route="app_user_edit"
                            data-parameters="{{ {'id': user.id}|json_encode|e('html_attr') }}">
                                <!-- pencil icon -->
                                <i class="bi bi-pencil"></i>
                        </a>
                        <a id="delete_user_{{ user.id }}"
                            class="btn btn-sm btn-outline-danger"
                            title="{{ 'Delete User'|trans }}"
                            {{ stimulus_target('modal', 'openModalButton') }}
                            {{ stimulus_action('modal', 'clickActionTable') }}
                            data-bs-toggle="modal"
                            data-bs-target="#deleteUserModal"
                            data-route="app_user_delete"
                            data-parameters="{{ {'id': user.id}|json_encode|e('html_attr') }}">
                                <!-- trash icon -->
                                <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
